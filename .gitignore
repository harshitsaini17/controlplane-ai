# Secrets — NFR-SEC-002: env only, never committed
.env
config/keys.yaml

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime artefacts
*.db
*.db-wal
*.db-shm
*.sqlite3

# Generated reports (06 §8). Reports are COMMITTED EVIDENCE, not build output: a README
# claim citing a report absent from the tree is an NFR-INT-001 violation, so the report
# travels in the same commit as the claim. Still never hand-edited — regenerate via the
# eval entry points.
#
# DEV-TAINTED artifacts are the one exception and stay ignored. ADR-018 defines them as
# resting on accounting that is not a measurement, so committing one would put a
# non-publishable number in the evidence tree, which is the opposite of the point.
reports/*.DEV-TAINTED.*
reports/**/*.DEV-TAINTED.*

# Model caches (sentence-transformers / spaCy)
.cache/
models/

# Crash artefacts. The headless chromium used by the diagram renderer dumps a core
# into the output directory (one was 342 MB); it is not a deliverable. A core dump can
# also contain process memory — including env-loaded secrets — so it must never be
# committed (NFR-SEC-002). Broadened from `core.[0-9]*` to cover `core`, `core.dmp` and
# any other suffix; verified no tracked file matches `core.*` at the time of widening.
core
core.*

# Local diagram render toolchain (node_modules for mermaid-cli).
# Rendered images in docs/diagrams/images/ ARE committed — the proposal, README and
# video reference them, and judges clone a public repo without a node toolchain.
.tools/
node_modules