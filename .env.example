# Environment variables for ControlPlane.ai — names are normative per docs/05 §6.
# Copy to .env and fill in locally. NEVER commit .env; values are never printed
# or logged (NFR-SEC-002).

# API key for the dev-class local gateway (config/gateway.yaml provider `kiro-local`).
UPSTREAM_API_KEY=

# API key for the measured-class provider (provider `groq`). Required before ANY
# judge-facing number is produced: dev-class data is tainted and eval/demo refuse it
# without --allow-dev (ADR-018). `ollama-local` needs no key.
GROQ_API_KEY=

# Optional. Escalation notification target, referenced from policy YAML as
# `webhook:${REVIEW_WEBHOOK_URL}` (04 §3 escalation.notify).
REVIEW_WEBHOOK_URL=

# SQLite database path for audit + metrics storage (05 §3, ADR-006).
CP_DB_PATH=./controlplane.db
